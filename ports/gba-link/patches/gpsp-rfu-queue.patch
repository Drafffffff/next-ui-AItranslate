+static void rfu_watch_dump(const char *reason) {
+  if (rfu_watch_dumped) return;
+  rfu_watch_dumped = true;
+  fprintf(stderr, "GBA Link WATCH %s: pc=%08x pointer=%08x bg0=%04x siocnt=%04x com=%u cmd=%02x cnt=%u plen=%u\n",
+    reason, reg[REG_PC], readaddress32(ewram, 0x33f0), read_ioreg(REG_BG0CNT),
+    read_ioreg(REG_SIOCNT), rfu_comstate, rfu_cmd, rfu_cnt, rfu_plen);
+  u32 start = rfu_trace_count > 64 ? rfu_trace_count - 64 : 0;
+  for (u32 n = start; n < rfu_trace_count; n++) {
+    unsigned k = n & 63;
+    fprintf(stderr, "GBA Link SPI trace: pc=%08x word=%08x com=%u cnt=%u plen=%u ticks=%u\n",
+      rfu_trace[k].pc, rfu_trace[k].word, rfu_trace[k].state,
+      rfu_trace[k].cnt, rfu_trace[k].plen, rfu_trace[k].tick);
+  }
+}
+void rfu_watch_dma(u32 src, u32 dst, u32 length, u32 type) {
+  if (!rfu_watch_enabled()) return;
+  fprintf(stderr, "GBA Link DMA large: pc=%08x src=%08x dst=%08x count=%u type=%u\n", reg[REG_PC], src, dst, length, type);
+  for (unsigned n = 0; n < 16; n++) fprintf(stderr, " r%u=%08x%s", n, reg[n], n%4==3?"\n":"");
+  rfu_watch_dump("dma-overwrites-library");
+}
+void rfu_watch_write(u32 address, u32 value, unsigned bits, u32 pc, unsigned source) {
+  if (!rfu_watch_enabled()) return;
+  u32 width = bits / 8, offset = address & 0x3ffff;
+  u32 old = 0, next = 0;
+  const char *name;
+  if ((address >> 24) == 2 && offset >= 0x33f0 && offset <= 0x33f3) {
+    old = readaddress32(ewram, 0x33f0); next = old;
+    for (u32 n = 0; n < width && offset + n <= 0x33f3; n++) {
+      u32 shift = (offset + n - 0x33f0) * 8;
+      next = (next & ~(255U << shift)) | (((value >> (n * 8)) & 255U) << shift);
+    }
+    name = "library-pointer";
+  } else if ((address >> 24) == 4 && (address & 0xffffff) == 8) {
+    old = read_ioreg(REG_BG0CNT); next = value & 0xdfff; name = "bg0-control";
+  } else return;
+  if (old == next) return;
+  if (((address >> 24) == 2 ? rfu_watch_pointer_changes++ : rfu_watch_changes++) < 256)
+    fprintf(stderr, "GBA Link WRITE %s: pc=%08x addr=%08x bits=%u source=%u old=%08x new=%08x com=%u cmd=%02x cnt=%u plen=%u\n",
+      name, pc, address, bits, source, old, next, rfu_comstate, rfu_cmd, rfu_cnt, rfu_plen);
+  if (old && (next >> 24) != 2 && (next >> 24) != 3 && (address >> 24) == 2) rfu_watch_dump(name);
+}

