 #include "common.h"

+#if defined(__linux__) || defined(__APPLE__)
+#include <time.h>
+#endif
+
+#ifndef RFU_NET_TIME_US
+static u64 rfu_net_time_us(void) {
+#if defined(__linux__) || defined(__APPLE__)
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0)
+    return (u64)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+#endif
+  return 0; // Other targets retain the emulated-cycle deadline.
+}
+#define RFU_NET_TIME_US() rfu_net_time_us()
+#endif
+
+/* One peer frame plus transport latency can exceed the original RF deadline.
+ * Keep emulated timing, but do not report failure before a bounded real-time
+ * grace of two 60Hz frames has elapsed. This does not sleep or stall rendering. */
+#define RFU_NET_GRACE_US 33334
+static u64 rfu_wait_started_us;
+static bool rfu_real_deadline_expired(u32 limit_us) {
+  u64 now = RFU_NET_TIME_US();
+  return !now || !rfu_wait_started_us || now - rfu_wait_started_us >= limit_us;
+}
