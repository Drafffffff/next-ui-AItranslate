+static struct { u32 word, pc, state, cnt, plen, tick; } rfu_trace[64];
+static u32 rfu_trace_count, rfu_watch_changes, rfu_watch_pointer_changes, rfu_stall_frames, rfu_watch_prev_progress;
+static bool rfu_watch_dumped, rfu_watch_game;
+void rfu_watch_configure(const char *code) {
+  rfu_watch_game = code && !strcmp(code, "BTME");
+}
+static bool rfu_watch_enabled(void) {
+  return rfu_watch_game &&
+    (rfu_state == RFU_STATE_HOST || rfu_state == RFU_STATE_CLIENT);
