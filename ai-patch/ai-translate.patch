+void CFG_setAIEndpoint(const char* url)
+{
+    if (url) {
+        strncpy(settings.aiEndpoint, url, sizeof(settings.aiEndpoint) - 1);
+        settings.aiEndpoint[sizeof(settings.aiEndpoint) - 1] = '\0';
+    } else {
+        settings.aiEndpoint[0] = '\0';
+    }
+    CFG_sync();
+}
+
