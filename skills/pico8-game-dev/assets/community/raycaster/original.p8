pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
mapsize = { w = 128, h = 128 }
screen = { w = 128, h = 96 }
texsize = { w = 8, h = 8 }
oldt = time()
t = time()
pos = { x = 3, y = 3 }--{ x = 7, y = 23}
dir = { x = -1, y = 0 }
plane = { x = 0, y = 0.66 }
starttime = 0
endtime = 0
palette = {
	0,   1,   140,  12,
	2,   136, 137,  9,
	131, 3,   139,  132,
	133, 5,   6,    7
}
darker = {
	0, 0, 1, 3,
	1, 4, 5, 6,
	1, 8, 9, 12,
	0, 12, 13, 14
}
darker_enabled = false

--tex = { 5, 6, 7, 8, 9 }
--tex = { 1, 2, 3, 4, 5 }
scene = {x=1,y=12,z=3,hz=48,rot=0,spd=0}
doorstate = {}
doorcoroutines = {}
doorframe = 10
boby = 0
bobx = 0
sprite_flag = 7
trigger_flag = 6
door_flag = 0
ending_tile = 57
sprites = {}
sprite_dict = {
	[29] = { sprite = 66, w = 2, h = 2, tc = 8, vmove = 0,  dw = 1, dh = 1 },
	[30] = { sprite = 74, w = 1, h = 1, tc = 8, vmove = 32, dw = 2, dh = 2 },
	[31] = { sprite = 98, w = 2, h = 2, tc = 8, vmove = 24, dw = 1.66, dh = 1.66 },
	[41] = { sprite = 41, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 },
	[42] = { sprite = 42, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 },
	[43] = { sprite = 43, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 },
	[44] = { sprite = 44, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 },
	[45] = { sprite = 45, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 },
	[46] = { sprite = 46, w = 1, h = 1, tc = 8, vmove = 38, dw = 3, dh = 3 },
	[60] = { sprite = 60, w = 1, h = 1, tc = 0, vmove = 38, dw = 3, dh = 3 }
}
triggers = {}
trigger_dict = {
	[33] = { text = "according to my sources\nthe facility should be here" },
	[34] = { text = "this must be the back door.\nmight need a key..." },
	[35] = { text = "ok, this is it! time to make\nthem pay for what they did" },
	[36] = { text = "this must be the main facility.\nlet's blow it all up!" }
}
keys_picked = { false, false, false, false, false }
spriteorder = {}
--spritedist = {}
zbuffer = {}

max_hp = 100
hp = 100
hp_pickup_amount = 10
max_ammo = 100
ammo = 30
ammo_pickup_amount = 15

show_dialog = false
dialog = "hidden"
dialog_coroutine = nil

-- sounds
is_walking_sound = false
is_sfx_on = false
walking_sound_coroutine = nil

function _init()
	--poke(0x5f2c, 3)
	poke(0x5f2e,1)
	for i = 0,15 do
		pal(i, palette[i+1],1)
	end
	for x = 1,mapsize.w do
		for y = 1,mapsize.h do
			maptile = mget(x, y)
			is_sprite_flag = fget(maptile, sprite_flag)
			is_trigger_flag = fget(maptile, trigger_flag)
			is_door_flag = fget(maptile, door_flag)

			if is_door_flag then
				doorstate[x + y * mapsize.w] = 0
			end
			if is_sprite_flag then
				add(sprites, { x = x, y = y, sprite = maptile, dist = 0 })
				mset(x, y, 0)
			end
			if is_trigger_flag then
				add(triggers, { x = x, y = y, trigger = maptile })
				mset(x, y, 0)
			end
		end
	end
	init_rotation()
	starttime = time()
	music(0)
end

function init_rotation()
	rotspeed = 3.1415 / 1.8
	olddirx = dir.x
	dir.x = dir.x * cos(-rotspeed) - dir.y * sin(-rotspeed)
	dir.y = olddirx * sin(-rotspeed) + dir.y * cos(-rotspeed)
	oldplanex = plane.x
	plane.x = plane.x * cos(-rotspeed) - plane.y * sin(-rotspeed)
	plane.y = oldplanex * sin(-rotspeed) + plane.y * cos(-rotspeed)
	scene.rot-=0.025
end

function darker_palette()
	if darker_enabled then return end

	for color = 0,15 do
		pal(color, darker[color+1])
	end

	darker_enabled = true
end

function normal_palette()
	if not darker_enabled then return end
	
	for color = 0,15 do
		pal(color, color)
		--pal(color, palette[color+1],1)
	end

	darker_enabled = false
end

function _draw()
	cls()
	clip(0,0,128, 96)
	palt(0, false)
	--mode()
	rectfill(0,scene.hz,127,127,13)
	rectfill(0, 0, 127, scene.hz, 1)
	for x=0,screen.w do
		drawing_door = false
		camx = 2*x / screen.w - 1
		raydir = { x = 0, y = 0 }
		raydir.x = dir.x + plane.x * camx
		raydir.y = dir.y + plane.y * camx
		
		mappos = {}
		mappos.x = flr(pos.x)
		mappos.y = flr(pos.y)
		sidedist = { x = 0, y = 0 }		
		step = { x = 0, y = 0 }
		walloffset = { x = 0, y = 0 }
		
		hit = 0
		side = 0
		perpwalldist = 0
		wallx = 0
		
		deltadist = { x = abs(1 / raydir.x), y = abs(1 / raydir.y) }

		if raydir.x < 0 then
			step.x = -1
			sidedist.x = (pos.x - mappos.x) * deltadist.x
		else
			step.x = 1
			sidedist.x = (mappos.x + 1 - pos.x) * deltadist.x
		end
		
		if raydir.y < 0 then
			step.y = -1
			sidedist.y = (pos.y - mappos.y) * deltadist.y
		else
			step.y = 1
			sidedist.y = (mappos.y + 1 - pos.y) * deltadist.y
		end
		
		while hit == 0 do
			if sidedist.x < sidedist.y then
				sidedist.x += deltadist.x
				mappos.x += step.x
				side = 0
			else
				sidedist.y += deltadist.y
				mappos.y += step.y
				side = 1
			end
			
			maptile = mget(mappos.x, mappos.y)
			--texture = tex[mget(mappos.x, mappos.y)]
			texture = maptile
			tileflag = fget(maptile)
			if maptile > 0 then
				is_door = fget(maptile, door_flag)
				if is_door then
					hit = 1

					if side == 1 then
						walloffset.y = 0.5 * step.y
						perpwalldist = (mappos.y - pos.y + walloffset.y + (1 - step.y) / 2 ) / raydir.y
						wallx = pos.x + perpwalldist * raydir.x;
						wallx -= flr(wallx);
						if sidedist.y - (deltadist.y / 2) < sidedist.x then
							-- TODO: door opening value, 0.75 for testing
							if 1.0 - wallx <= doorstate[mappos.x + mappos.y * mapsize.w] then
								hit = 0
								walloffset.y = 0
							end
						else
							mappos.x += step.x
							side = 0
							walloffset.y = 0
							texture = 10
						end
					else
						walloffset.x = 0.5 * step.x
						perpwalldist = (mappos.x - pos.x + walloffset.x + (1 - step.x) / 2 ) / raydir.x
						wallx = pos.y + perpwalldist * raydir.y;
						wallx -= flr(wallx);
						if sidedist.x - (deltadist.x / 2) < sidedist.y then
							-- TODO: door opening value, 0.75 for testing
							if 1.0 - wallx <= doorstate[mappos.x + mappos.y * mapsize.w] then
								hit = 0
								walloffset.y = 0
							end
						else
							mappos.y += step.y
							side = 1
							walloffset.x = 0
							texture = 10
						end
					end
				else
					if side == 1 and mget(mappos.x, mappos.y - step.y) == 3 then
						texture = doorframe;
					elseif side == 0 and mget(mappos.x - step.x, mappos.y) == 3 then
						texture = doorframe;
					end
					hit = 1
				end
			end
		end
		
		if side == 0 then
			perpwalldist = (mappos.x - pos.x + walloffset.x + (1 - step.x) / 2) / raydir.x
		else
			perpwalldist = (mappos.y - pos.y + walloffset.y + (1 - step.y) / 2) / raydir.y
		end
		
		lineheight = flr(screen.h / perpwalldist)
		
		drawstart = -lineheight / 2 + screen.h / 2
		drawstart_neg = drawstart
		if drawstart < 0 then
			drawstart = 0
		else
			drawstart_neg = 0
		end
		drawend = lineheight / 2 + screen.h / 2
		if drawend >= screen.h then
			drawend = screen.h - 1
		end
		
		if side == 0 then 
			wallx = pos.y + perpwalldist * raydir.y
		else
			wallx = pos.x + perpwalldist * raydir.x
		end

		wallx -= flr(wallx);

		tex_x = flr(wallx * texsize.w)
		if side == 0 and raydir.x > 0 then
			tex_x = texsize.w - tex_x - 1
		end

		if side == 1 and raydir.y < 0 then
			tex_x = texsize.w - tex_x - 1
		end
	
		if side == 1 then
			darker_palette()
		else
			normal_palette()
		end

		--line(x, drawstart, x, drawend, wallcol) -- todo: bug, enable this line to see it
		texpos_x = (texture % 16) * 8 + tex_x
		texpos_y = flr((texture \ 16) * 8)
		sspr(texpos_x, texpos_y, 1, texsize.h, x, drawstart+drawstart_neg, 1, drawend-drawstart-2*drawstart_neg)

		-- sprite rendering
		zbuffer[x] = perpwalldist

	end

	normal_palette()

	for i=1,#sprites do
		spriteorder[i] = i
		sprites[i].dist = (pos.x - sprites[i].x) * (pos.x - sprites[i].x) + (pos.y - sprites[i].y) * (pos.y - sprites[i].y)
	end
	
	sort(sprites, comparedist)
	
	debugprint = ""
	debugprint2 = ""
	invdet = 1.0 / (plane.x * dir.y - dir.x * plane.y)
	picked_up = {} -- items that were picked up this frame
	i = 1
	for i = 1,#sprites do
		local sprite = sprites[i]
		local real_spr = sprite_dict[sprite.sprite]
		sprx = sprite.x - pos.x + 0.5
		spry = sprite.y - pos.y + 0.5

		-- inverse camera transform matrix
		transformx = invdet * (dir.y * sprx - dir.x * spry)
		transformy = invdet * (-plane.y * sprx + plane.x * spry)

      	vmovescr = flr(real_spr.vmove / transformy);
		spritescreenx = flr((screen.w / 2) * (1 + transformx / transformy))
		spriteheight = abs(flr(screen.h / transformy)) / real_spr.dh

		drawstarty = -spriteheight / 2 + screen.h / 2 + vmovescr
		if drawstarty < 0 then drawstarty = 0 end
		drawendy = spriteheight / 2 - screen.h / 2 + vmovescr
		if drawendy >= screen.h then drawendy = screen.h - 1 end


		spritewidth = abs(flr(screen.h / transformy)) / real_spr.dw
		drawstartx = -spritewidth / 2 + spritescreenx
		--if drawstartx < 0 then drawstartx = 0 end --TODO: rather drawstartx - spritewidth < 0 then drawstart = -spritewidth
		drawendx = spritewidth / 2 + spritescreenx
		--if drawendx >= screen.w then drawendx = screen.w - 1 end

		texpos_x = (real_spr.sprite % 16) * 8 -- + tex_x
		texpos_y = flr((real_spr.sprite \ 16) * 8)

		if transformy > 0 and spritescreenx > 0 and spritescreenx < screen.w - 1 then
			--rectfill(drawstartx, 56+drawstarty, drawendx, 56+drawendy, 5+i)
			non_occ_found = false
			first_nonocc_x = drawstartx
			last_nonocc_x = drawendx
			for sprx = drawstartx,drawendx do
				if sprx > 0 and sprx < 128 and zbuffer[flr(sprx)] > transformy then
					if not non_occ_found then
						first_nonocc_x = sprx
						non_occ_found = true
					else
						last_nonocc_x = sprx
					end
				end
			end

			drawn_width = drawendx - drawstartx
			pixel_scale = drawn_width / (real_spr.w * 8) --(real_spr.w * 8) / drawn_width
			hidden_pixels_start = (first_nonocc_x - drawstartx) / pixel_scale
			hidden_pixels_end = (drawendx - last_nonocc_x) / pixel_scale

			palt(0, false)
			palt(real_spr.tc, true)
			if non_occ_found then
				sspr(texpos_x + hidden_pixels_start, texpos_y,
					 real_spr.w*8 - hidden_pixels_end - hidden_pixels_start, real_spr.h*8,
					 first_nonocc_x, drawstarty,
					 last_nonocc_x-first_nonocc_x, spriteheight)
			end
			palt(real_spr.tc, false)
			palt(0, true)
			if sprite.sprite == 60 then
				debugprint = sprx .. ", " .. spry .. " - " .. sprite.x .. ", " .. sprite.y
				debugprint2 = zbuffer[flr(max(drawstartx, 0))] .. ", " .. transformy
			end
		end

		if abs(sprx) < 0.5 and abs(spry) < 0.5 then
			sound_timeout = 0.5
			if real_spr.sprite == 46 and hp < max_hp then
				hp = min(max_hp, hp + hp_pickup_amount)
				add(picked_up, sprite)
				sfx(2, 3)
				is_sfx_on = true
			elseif real_spr.sprite == 45 and ammo < max_ammo then
				ammo = min(max_ammo, ammo + ammo_pickup_amount)
				add(picked_up, sprite)
				sfx(2, 3)
				is_sfx_on = true
			else
				if pickup_item(real_spr.sprite) then
					sfx(1, 3)
					sound_timeout = 1.6
					is_sfx_on = true
					add(picked_up, sprite)
				end
			end

			walking_sound_coroutine = cocreate(function () continue_walking(time(), sound_timeout) yield() end)
		end
	end

	for i in all(picked_up) do
		del(sprites, i)
	end

	for i = 1, #triggers do
		local trigger = triggers[i]
		local trigger_data = trigger_dict[trigger.trigger]
		trgx = trigger.x - pos.x + 0.5
		trgy = trigger.y - pos.y + 0.5

		if abs(trgx) < 0.5 and abs(trgy) < 0.5 then
			show_dialog = true
			dialog = trigger_data.text
			dialog_coroutine = cocreate(function() opendialog(time(), 5) yield() end)
		end
	end
	
	clip()
	palt(0, true)

	-- draw guns
	--line(32, 77, 29, 70, 5)
	--line(32, 77, 37, 72, 5)
	--line(29, 70, 35, 55, 5)
	--line(37, 72, 35, 55, 5)
	--line(32, 75, 31, 71, 7)
	--line(32, 75, 35, 72, 7)
	--line(31, 71, 34, 62, 7)
	--line(35, 72, 34, 62, 7)
	sspr((64 % 16) * 8, (64 \ 16) * 8, 16, 16, 16-bobx, 68-boby, 32, 32)
	sspr((64 % 16) * 8, (64 \ 16) * 8, 16, 16, 80-bobx, 68-boby, 32, 32, true)

	-- draw hud
	rectfill(0, 96, 127, 127, 0)
	rect(0, 96, 127, 127, 4)
	-- draw keys
	local key_y = 116
	local key_x = 66
	print("keys", key_x-20, key_y+2)
	rect(key_x, key_y, key_x+55, key_y+8, 4)
	if keys_picked[1] then
		spr(60, key_x+1, key_y)
	end
	for i = 0, 3 do
		if keys_picked[i+2] then
			spr(41+i, key_x+13+11*i, key_y)
		end
		line(key_x+11+i*11, key_y, key_x+11+i*11, key_y+8, 4)
	end
	-- draw hp and ammo
	local hp_x = 3
	local hp_y = 105
	local hp_w = 120
	local ammo_x = 66
	local ammo_y = 105
	print("battery", hp_x, hp_y-6)
	for hpx = 0, max(0, flr((hp_w*hp)/max_hp)) do
		line(hpx+hp_x, hp_y+1, hpx+hp_x, hp_y+5, 10)
	end
	rect(hp_x, hp_y, hp_x+hp_w+1, hp_y+6, 4)
	--print("ammo", ammo_x+44, ammo_y-6, 4)
	--for ammox = 0, max(0, flr((57*ammo)/max_ammo)) do
	--	line(ammox+ammo_x, ammo_y+1, ammox+ammo_x, ammo_y+5, 10)
	--end
	--rect(ammo_x, ammo_y, ammo_x+58, ammo_y+6, 4)
	-- kill count
	--local kill_y = 116
	--local kill_x = 23
	--print("kills:", kill_x-20, kill_y+2)
	--killcount = 0
	--print(killcount, kill_x+5, kill_y+2)

	-- dialog
	if show_dialog then
		rectfill(0, 0, 127, 14, 0)
		rect(0, 0, 127, 14, 4)
		print(dialog, 2, 2, 4)
	end

	oldt = t
	t = time()
	dt = t - oldt
	hp = hp - 0.5*dt
	
	movespeed = 2.5 * dt
	-- default: rotspeed = 0.65 * dt
	rotspeed = 0.25 * dt
	
	pw = 0.5
	movedirx = (dir.x * movespeed) / abs(dir.x * movespeed)
	movediry = (dir.y * movespeed) / abs(dir.y * movespeed)
	
	-- forward
	if btn(2) then
		boby = sin(t/1.5)*3
		bobx = cos(t/3)*4.5
		opendoor = false
		maptile = mget(flr(pos.x + (movedirx * pw) + dir.x * movespeed), pos.y)
		tileflag = fget(maptile)

		if tileflag == 1 then
			cur_door_state = doorstate[flr(pos.x + (movedirx * pw) + dir.x * movespeed) + flr(pos.y) * mapsize.w]
			if cur_door_state != nil then
				opendoor = cur_door_state >= 1
			end
		end


		if maptile == 0 or tileflag == 2 or opendoor then
			pos.x += dir.x * movespeed
			scene.x -= dir.x * movespeed * 0.55
		end
		maptile = mget(pos.x, flr(pos.y + (movediry * pw) + dir.y * movespeed))
		tileflag = fget(maptile)
		
		opendoor = false
		
		if tileflag == 1 then
			cur_door_state = doorstate[flr(pos.x) + (flr(pos.y + (movediry * pw) + dir.y * movespeed)) * mapsize.w]
			if cur_door_state != nil then
				opendoor = cur_door_state >= 1
			end
		end

		if maptile == 0 or tileflag == 2 or opendoor then
			pos.y += dir.y * movespeed
			scene.y += dir.y * movespeed * 0.55
			if not is_walking_sound and not is_sfx_on then
				is_walking_sound = true
				sfx(0, 3)
			end
		else
			sfx(0, -2)
			is_walking_sound = false
		end
	elseif btn(3) then
		boby = sin(t/2)*4
		bobx = cos(t/3)*3
		opendoor = false
		maptile = mget(flr(pos.x - (movedirx * pw) - dir.x * movespeed), pos.y)
		tileflag = fget(maptile)

		if tileflag == 1 then
			cur_door_state = doorstate[flr(pos.x - (movedirx * pw) - dir.x * movespeed) + flr(pos.y) * mapsize.w]
			if cur_door_state != nil then
				opendoor = cur_door_state >= 1
			end
		end

		if maptile == 0 or tileflag == 2 or opendoor then
			pos.x -= dir.x * movespeed
			scene.x += dir.x * movespeed * 0.55
		end

		maptile = mget(pos.x, flr(pos.y - (movediry * pw) - dir.y * movespeed))
		tileflag = fget(maptile)
		opendoor = false
		
		if tileflag == 1 then
			cur_door_state = doorstate[flr(pos.x) + (flr(pos.y - (movediry * pw) - dir.y * movespeed)) * mapsize.w]
			if cur_door_state != nil then
				opendoor = cur_door_state >= 1
			end
		end

		if maptile == 0 or tileflag == 2 or opendoor then
			pos.y -= dir.y * movespeed
			scene.y -= dir.y * movespeed * 0.55
			if not is_walking_sound and not is_sfx_on then
				is_walking_sound = true
				sfx(0, 3)
			end
		else
			sfx(0, -2)
			is_walking_sound = false
		end

		-- todo: move through doors backwards
	else
		boby = 0
		bobx = 0
		sfx(0, -2)
		is_walking_sound = false
	end

	-- turning
	if btn(0) then
		olddirx = dir.x
		dir.x = dir.x * cos(-rotspeed) - dir.y * sin(-rotspeed)
		dir.y = olddirx * sin(-rotspeed) + dir.y * cos(-rotspeed)
		oldplanex = plane.x
		plane.x = plane.x * cos(-rotspeed) - plane.y * sin(-rotspeed)
		plane.y = oldplanex * sin(-rotspeed) + plane.y * cos(-rotspeed)
		scene.rot-=0.025
	end
	if btn(1) then
		olddirx = dir.x
		dir.x = dir.x * cos(rotspeed) - dir.y * sin(rotspeed)
		dir.y = olddirx * sin(rotspeed) + dir.y * cos(rotspeed)
		oldplanex = plane.x
		plane.x = plane.x * cos(rotspeed) - plane.y * sin(rotspeed)
		plane.y = oldplanex * sin(rotspeed) + plane.y * cos(rotspeed)
		scene.rot+=0.025
	end

	if btnp(4) then
		fwdpos = { x = flr(pos.x + dir.x), y = flr(pos.y + dir.y) }
		doori = fwdpos.x + fwdpos.y * mapsize.w
		tileid = mget(fwdpos.x, fwdpos.y)
		if tileid == ending_tile then
			endtime = time()
			load("ending.p8", "quick restart", endtime - starttime)
		end
		if doorstate[doori] != nil and doorcoroutines[doori] == nil and open_door(tileid) then
			cor = cocreate(function() dooropening(doori) yield() end)
			doorcoroutines[doori] = cor
		end
	end

	for k,v in pairs(doorcoroutines) do
		if v != nil and costatus(v) != "dead" then
			coresume(v)
			print(1 , 0, 16, 8)
		end
	end

	if dialog_coroutine != nil and costatus(dialog_coroutine) != "dead" then
		coresume(dialog_coroutine)
	end

	if walking_sound_coroutine != nil and costatus(walking_sound_coroutine) != "dead" then
		coresume(walking_sound_coroutine)
	end
	--rectfill(0, 0, 20, 20, 1)
	--print(stat(1), 0, 0, 15)
	--print(debugprint, 0, 7, 15)
	--print(debugprint2, 0, 14, 15)
end

function open_door(tileid)
	if tileid == 12 then
		return keys_picked[1]
	end
	if tileid == 9 then
		return keys_picked[2]
	end
	if tileid == 53 then
		return keys_picked[3]
	end
	if tileid == 54 then
		return keys_picked[4]
	end
	if tileid == 55 then
		return keys_picked[5]
	end

	return true
end

function pickup_item(sprite_id)
	if sprite_id == 60 then
		keys_picked[1] = true
		return true
	end
	if sprite_id == 41 then
		keys_picked[2] = true
		return true
	end
	if sprite_id == 42 then
		keys_picked[3] = true
		return true
	end
	if sprite_id == 43 then
		keys_picked[4] = true
		return true
	end
	if sprite_id == 44 then
		keys_picked[5] = true
		return true
	end
	return false
end

-- door opening coroutine
function dooropening(index)
	is_sfx_on = true
	sfx(3, 3)
	while doorstate[index] < 1 do
		doorstate[index] = doorstate[index] + 0.05
		yield()
	end
	is_sfx_on = false
	is_walking_sound = false
end

function opendialog(start, timeout)
	while time() - start < timeout do
		show_dialog = true
		yield()
	end
	show_dialog = false
end

function continue_walking(start, timeout)
	while time() - start < timeout do
		yield()
	end
	-- forces the walking sound to start playing again next frame
	is_sfx_on = false
	is_walking_sound = false
	--if is_walking_sound then
	--	sfx(0, 3)
	--end
	walking_sound_coroutine = nil
end

function comparedist(t1, t2)
	return t1.dist < t2.dist
end

function sort(tbl, cmp)
	for i = 1,#tbl do
		local j = i
		while j > 1 and cmp(tbl[j-1], tbl[j]) do
			tbl[j], tbl[j-1] = tbl[j-1], tbl[j]
			j = j - 1
		end
	end
end
