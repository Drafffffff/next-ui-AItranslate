pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- original starter assets: see catalog.json
-- sprite 0 is blank; ids 1-12 are fixed.

function _init()
 px=60
 py=64
end

function _update()
 if btn(0) then px=px-2 end
 if btn(1) then px=px+2 end
 if btn(2) then py=py-2 end
 if btn(3) then py=py+2 end
 px=mid(8,px,112)
 py=mid(16,py,104)
end

function _draw()
 cls(1)
 for y=16,104,8 do
  for x=8,112,8 do
   spr(9,x,y)
  end
 end
 for x=0,120,8 do
  spr(8,x,8)
  spr(8,x,112)
 end
 for y=16,104,8 do
  spr(8,0,y)
  spr(8,120,y)
 end
 spr(1,16,24)
 spr(2,32,24)
 spr(3,48,24)
 spr(5,64,24)
 spr(6,80,24)
 spr(7,96,24)
 spr(10,16,40)
 spr(11,32,40)
 spr(12,48,40)
 spr(4,px,py)
 print("ai game starter",2,1,7)
 print("d-pad: move",2,121,7)
end
