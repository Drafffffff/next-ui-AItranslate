  "name": "Pocket PICO-8 Starter Assets",
  "description": "Small original 8x8 pixel sprites for AI-generated games. The SVG is a human preview only; the .p8 cartridge is the runtime source.",
  "license": "GPL-3.0-only",
  "license_file": "../../../LICENSE",
  "provenance": {
    "source": "Original pixel art authored for this repository; no third-party artwork or downloads.",
    "palette": "Standard PICO-8 palette indices 0 through 15."
  },
  "usage": {
    "starter_cartridge": "starter.p8",
    "preview": "sprite-atlas.svg",
    "sprite_size": [
      8,
      8
    ],
    "sprite_sheet_size": [
      128,
      128
    ],
    "reserved_sprite_ids": [
      0
    ],
    "transparent_color_index": 0,
    "pixel_encoding": "Each sprite has eight strings of eight lowercase hexadecimal palette indices. Rows are top-to-bottom; columns are left-to-right.",
    "draw": "spr(id, x, y) draws one 8x8 sprite. Coordinates are the upper-left corner. Sprite 0 is fully transparent.",
    "sheet_mapping": "A sprite starts at x=(id%16)*8, y=flr(id/16)*8. The starter includes a complete 128x128 __gfx__ section.",
    "collision": "The sprites do not set collision flags or movement rules; define hitboxes and collisions in Lua.",
    "editing": "Preserve the __gfx__ section and fixed built-in IDs 1 through 12 when modifying Lua. Sprite 0 stays fully transparent. First-version model-created sprites may only use IDs 32 through 63; IDs 13 through 31 are reserved for future built-in packs. Do not use IDs 128 through 255 because their sheet region shares storage with the map.",
    "sound": "No sounds are supplied. This avoids requiring any nonessential audio or cartridge section format.",
    "model_custom_sprite_id_range": {
      "min": 32,
      "max": 63
    },
    "future_builtin_sprite_id_range": {
      "min": 13,
      "max": 31
    }
  },
